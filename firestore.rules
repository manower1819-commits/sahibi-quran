rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function halaqa(id) { return get(/databases/$(database)/documents/halaqas/$(id)).data; }
    // Parents of a child: the owner (parentUid) and any co-parents (parentUids) who joined with the owner's invite.
    function isParentOf(d) { return d.parentUid == me() || me() in d.get('parentUids', []); }
    // An approval (halaqas/{hid}/requests/{kidId}, status 'approved') is good for 7 days from the moment the server recorded it.
    function approved(hid, kidId) {
      let r = get(/databases/$(database)/documents/halaqas/$(hid)/requests/$(kidId)).data;
      return r.status == 'approved' && r.decidedAt > request.time - duration.value(7, 'd');
    }
    // A child may point at a class only after that class's teacher approved the request.
    function linkOk(d, kidId) {
      return d.get('teacherUid', null) == null
        || (d.get('halaqaId', null) != null
            && halaqa(d.halaqaId).teacherUid == d.teacherUid
            && approved(d.halaqaId, kidId));
    }

    // Parent/teacher profile (reminder times, device tokens). Owner only.
    match /users/{uid} {
      allow read, write: if signedIn() && me() == uid;
    }

    // Class code -> class id. Looking up one code is allowed; listing the codes is not.
    match /halaqaCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && code.matches('[A-Z0-9]{4,12}')
                    && request.resource.data.keys().hasOnly(['hid', 'teacherUid'])
                    && request.resource.data.teacherUid == me()
                    && halaqa(request.resource.data.hid).teacherUid == me();
      allow delete: if signedIn() && resource.data.teacherUid == me();
    }

    // Classes: one class can be read by anyone signed in who knows its id (members and people who looked up its code),
    // but classes cannot be listed except by their own teacher. Only the teacher changes a class.
    match /halaqas/{hid} {
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.teacherUid == me();
      allow create: if signedIn() && request.resource.data.teacherUid == me();
      allow update: if signedIn() && resource.data.teacherUid == me() && request.resource.data.teacherUid == me();
      allow delete: if signedIn() && resource.data.teacherUid == me();

      // Join requests: a parent asks, only the class's teacher decides.
      match /requests/{kidId} {
        // read and delete: the class's teacher, the parent who made the request, or any parent of that child (a co-parent sees and cancels the owner's request, and the owner a co-parent's)
        allow read: if signedIn() && (resource == null || halaqa(hid).teacherUid == me() || resource.data.parentUid == me()
                                      || isParentOf(get(/databases/$(database)/documents/kids/$(kidId)).data));
        allow create: if signedIn()
                      && request.resource.data.keys().hasOnly(['kidId', 'parentUid', 'teacherUid', 'kidName', 'status', 'at'])
                      && request.resource.data.kidId == kidId
                      && request.resource.data.parentUid == me()
                      && request.resource.data.teacherUid == halaqa(hid).teacherUid
                      && request.resource.data.status == 'pending'
                      && request.resource.data.kidName is string && request.resource.data.kidName.size() <= 30
                      && request.resource.data.at is number && request.resource.data.at <= request.time.toMillis() + 600000
                      && isParentOf(get(/databases/$(database)/documents/kids/$(kidId)).data);
        // A request can be decided within 30 days of being made; an old forgotten one cannot be revived by the teacher.
        allow update: if signedIn() && halaqa(hid).teacherUid == me()
                      && resource.data.at is number && resource.data.at > request.time.toMillis() - 2592000000
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt'])
                      && request.resource.data.decidedAt == request.time
                      && request.resource.data.status in ['approved', 'rejected'];
        allow delete: if signedIn() && (halaqa(hid).teacherUid == me() || resource.data.parentUid == me()
                                        || isParentOf(get(/databases/$(database)/documents/kids/$(kidId)).data));
      }
    }

    // The invite the owner last made for a child. Its code is kept in kids/{id}/private/invite, which only the parents can read
    // (the child's own document is also read by the class teacher, who must never learn the code).
    function inviteOf(kidId) {
      return get(/databases/$(database)/documents/invites/$(get(/databases/$(database)/documents/kids/$(kidId)/private/invite).data.code)).data;
    }
    // Co-parent invites: the owner creates one (and records its code in kids/{id}/private/invite); whoever holds the code may claim it once.
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && code.matches('[A-Z0-9]{8}')
                    && request.resource.data.keys().hasOnly(['kidId', 'ownerUid', 'exp', 'claimedBy'])
                    && request.resource.data.ownerUid == me()
                    && request.resource.data.get('claimedBy', null) == null
                    && request.resource.data.exp is number
                    && get(/databases/$(database)/documents/kids/$(request.resource.data.kidId)).data.parentUid == me();
      allow update: if signedIn()
                    && resource.data.get('claimedBy', null) == null
                    && resource.data.exp > request.time.toMillis()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedBy'])
                    && request.resource.data.claimedBy == me();
      allow delete: if signedIn() && (resource.data.ownerUid == me() || resource.data.get('claimedBy', null) == me());
    }

    // Teacher's "Remind" taps wait here; the scheduled job sends them and deletes them.
    match /reminders/{rid} {
      allow create: if signedIn() && request.resource.data.teacherUid == me()
                    && request.resource.data.keys().hasOnly(['kidId', 'teacherUid', 'lang', 'at', 'kind'])
                    && request.resource.data.get('kind', 'remind') in ['remind', 'note']
                    && get(/databases/$(database)/documents/kids/$(request.resource.data.kidId)).data.get('teacherUid', null) == me();
    }

    match /kids/{kid} {
      allow read: if signedIn() && (isParentOf(resource.data) || resource.data.get('teacherUid', null) == me());
      // A new child belongs only to its creator, and may only point at a class that approved it.
      allow create: if signedIn() && request.resource.data.parentUid == me()
                    && request.resource.data.get('parentUids', [me()]).hasOnly([me()])
                    && linkOk(request.resource.data, kid);
      // Owner and co-parents may edit the child. Ownership never moves; a co-parent can only remove people from parentUids.
      allow update: if signedIn() && isParentOf(resource.data)
                    && request.resource.data.parentUid == resource.data.parentUid
                    && (resource.data.parentUid == me()
                        ? request.resource.data.get('parentUids', [resource.data.parentUid]).hasAny([me()])
                        : request.resource.data.get('parentUids', []).toSet().difference(resource.data.get('parentUids', []).toSet()).size() == 0)
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['halaqaId', 'teacherUid'])
                        || linkOk(request.resource.data, kid));
      // A co-parent joins: the child names an invite that this user has claimed. Only parentUids/parentNames change,
      // and only this user is added (and may add their own display name).
      allow update: if signedIn() && !isParentOf(resource.data)
                    && exists(/databases/$(database)/documents/kids/$(kid)/private/invite)
                    && inviteOf(kid).claimedBy == me()
                    && inviteOf(kid).kidId == kid
                    && inviteOf(kid).exp > request.time.toMillis()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parentUids', 'parentNames'])
                    && request.resource.data.parentUids.hasAll(resource.data.get('parentUids', [resource.data.parentUid]))
                    && request.resource.data.parentUids.toSet().difference(resource.data.get('parentUids', [resource.data.parentUid]).toSet()).hasOnly([me()])
                    && request.resource.data.get('parentNames', {}).diff(resource.data.get('parentNames', {})).affectedKeys().hasOnly([me()])
                    && (!(me() in request.resource.data.get('parentNames', {}))
                        || (request.resource.data.parentNames[me()] is string && request.resource.data.parentNames[me()].size() <= 30));
      // The teacher can take a student out of the class, or put an approved, currently unassigned child into it.
      allow update: if signedIn() && resource.data.get('teacherUid', null) == me()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['halaqaId', 'teacherUid'])
                    && request.resource.data.get('teacherUid', null) == null;
      allow update: if signedIn() && resource.data.get('teacherUid', null) == null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['halaqaId', 'teacherUid'])
                    && request.resource.data.get('teacherUid', null) == me()
                    && request.resource.data.get('halaqaId', null) != null
                    && halaqa(request.resource.data.halaqaId).teacherUid == me()
                    && approved(request.resource.data.halaqaId, kid);
      // Only the owner deletes a child.
      allow delete: if signedIn() && resource.data.parentUid == me();

      // Things only the parents may see (the invite code): not the class teacher.
      match /private/{doc} {
        allow read, write: if signedIn() && isParentOf(get(/databases/$(database)/documents/kids/$(kid)).data);
      }

      match /days/{date} {
        function k() { return get(/databases/$(database)/documents/kids/$(kid)).data; }
        function isParent() { return isParentOf(k()); }
        function isTeacher() { return k().get('teacherUid', null) == me(); }
        function homeKeys() { return ['items', 'stars', 'weak', 'extra', 'nS', 'nF', 'nT', 'notes', 'pw']; }
        function classKeys() { return ['items', 'tStars', 'tWeak', 'tNotes', 'tpw']; }
        function changed() {
          return resource == null ? request.resource.data.keys() : request.resource.data.diff(resource.data).affectedKeys();
        }
        allow read: if signedIn() && (isParent() || isTeacher());
        // Home rating belongs to the family; class rating belongs to the teacher.
        function pageList(key) { return request.resource.data.get(key, []) is list && request.resource.data.get(key, []).size() <= 604; }
        allow create, update: if signedIn() && pageList('pw') && pageList('tpw') && (
          (isParent() && changed().hasOnly(homeKeys())) ||
          (isTeacher() && changed().hasOnly(classKeys())));
        allow delete: if signedIn() && isParent();
      }
    }
  }
}
